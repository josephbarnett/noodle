    <diagram id="planes-022" name="Two-process architecture (ADR 022, corrected 2026-08-11)">
        <mxGraphModel dx="2000" dy="1000" grid="0" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="0" pageScale="1" pageWidth="1900" pageHeight="1000" math="0" shadow="0">
            <root>
                <mxCell id="0"/>
                <mxCell id="1" parent="0"/>
                <mxCell id="title" value="ADR 022 / 057 — noodle data plane ⇒ tap.jsonl + side_effects.jsonl ⇒ embellishment plane (in-repo) ⇒ OTel collector ⇒ downstream backends" style="text;html=1;align=center;verticalAlign=middle;fontSize=15;fontStyle=1" parent="1" vertex="1">
                    <mxGeometry x="60" y="18" width="1780" height="28" as="geometry"/>
                </mxCell>
                <mxCell id="subtitle" value="Two file boundaries: tap.jsonl + side_effects.jsonl (proxy ⇒ embellish) and SQLite (embellish ⇒ shipper). noodle-shipper POSTs OTLP itself — there is no collector-side filelog receiver tailing noodle's files." style="text;html=1;align=center;verticalAlign=middle;fontSize=10;fontStyle=2;fontColor=#555555" parent="1" vertex="1">
                    <mxGeometry x="60" y="47" width="1780" height="16" as="geometry"/>
                </mxCell>
                <mxCell id="freshness" value="Freshness pass 2026-08-11 — the original diagram assumed the collector ingested noodle's output via a filelog receiver and stated &quot;noodle has no OTLP code&quot;. Corrected against crates/noodle-shipper/src/exporter.rs, which POSTs OTLP/HTTP directly via reqwest." style="text;html=1;align=center;verticalAlign=middle;fontSize=9;fontStyle=2;fontColor=#888888" parent="1" vertex="1">
                    <mxGeometry x="60" y="64" width="1780" height="16" as="geometry"/>
                </mxCell>

